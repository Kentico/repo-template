    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/plugin-transform-runtime": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/preset-react": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "@kentico/xperience-webpack-config": "31.9.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "babel-loader": "10.1.1",
    "typescript": "5.9.3",
    "webpack": "5.111.0",
    "webpack-cli": "7.2.3",
    "webpack-dev-server": "6.0.0"
  },
  "overrides": {
