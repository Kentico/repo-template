{
  "name": "repotemplate-e2e",
  "version": "1.0.0",
  "description": "End-to-end tests for the DancingGoat sample and this repository's Xperience extensions.",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:live-site": "playwright test --project=live-site",
    "test:admin": "playwright test --project=admin-tests",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "install:browsers": "playwright install chromium",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  }
}
